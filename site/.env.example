# Copier ce fichier en « .env » et renseigner l'adresse définitive du site (sans « / » final).
# Utilisée pour : balise canonical, sitemap.xml, robots.txt, aperçus de partage, données Google.
SITE_URL=https://www.pharmacie-saint-loup.fr

# Clé d'accès Web3Forms (https://web3forms.com) : le formulaire de contact envoie les messages
# à l'adresse e-mail liée à cette clé (pharmaciesaintloup45@gmail.com).
VITE_WEB3FORMS_KEY=

# Envoi des ordonnances (fonction serveur api/ordonnance.ts) : à définir dans Vercel > Settings > Environment Variables.
# Avec Gmail : SMTP_USER = l'adresse Gmail, SMTP_PASS = un « mot de passe d'application » (pas le mot de passe du compte).
SMTP_USER=pharmaciesaintloup45@gmail.com
SMTP_PASS=
# Facultatif : adresse qui reçoit les ordonnances (par défaut SMTP_USER), et serveur SMTP autre que Gmail.
# ORDONNANCE_EMAIL=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
